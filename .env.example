# ===== 群智 v18 配置模板 =====
# 复制成 .env 后填真实值

# --- LLM providers（至少填一个）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# --- 鉴权 ---
# 管理 key（32 位随机，openssl rand -hex 16）
QZ_ADMIN_KEY=
# 用户访问 key（32 位随机）
QUNZHI_ACCESS_KEY=
# 演示 key（比赛/展示用，限额 1000/天）
QZ_DEMO_KEY=
QZ_DEMO_DAILY_QUOTA=1000

# --- 数据库 ---
PAPERLIB_DB=/path/to/paperlib.sqlite

# --- 服务 ---
GATEWAY_PORT=5020
V18_ENGINE_URL=http://127.0.0.1:18097