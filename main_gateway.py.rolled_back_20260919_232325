def _deep_critic_review(topic: str, report: str, human_report: str = "") -> str:
    """深批者：对抗性批判审视（模拟资深从业者红队评审）。

    设计要点（对标 v3 评审的"证据引用"机制）：
      - 每条批判必须点名报告中的具体建议，禁止泛泛而谈；
      - 区分"方向错"与"执行难"两类问题；
      - 必须给"如果一定要做，先解决什么"——只拆不建是无效批判。
    这是群智"负结果如实报告"方法论在单次输出上的延伸。
    """
    source = (human_report or report) or ""
    prompt = f"""你是群智的「深批者」——一个见惯了失败项目的资深从业者，专门负责拆台。
课题：{topic}

团队刚产出下面这份决策建议。你的任务不是复述风险，而是指出它**在真实世界里会怎么死**。

【硬性要求（违反即不合格）】
1. 至少 3 条批判必须**点名报告里的具体建议**（引用其原话或内容），禁止"存在风险""需注意执行"这类空话；
2. 每条批判要给**具体场景**：谁、在什么情况下、会怎么做、导致什么后果；
3. 区分两类问题并标注：
   ❌ **方向错**＝这条建议的前提本身就不成立；
   ⚠️ **执行难**＝方向对，但现实中推不动（说清卡在哪一环）；
4. 结尾必须给"**如果一定要做，先解决什么**"——只拆不建等于没批；
5. 禁止客套、禁止和稀泥（如"总体而言建议还是有价值的"），宁可刻薄不要油腻。

【检查维度】
① **最脆弱的假设**：报告默认了哪些"人会配合/资源到位/制度会执行"？哪一条一旦不成立，整套建议就崩？
② **现实阻力的落点**：点名哪条建议在真实环境（预算/人力/部门利益/流程惯性）下推不动，卡在谁那里；
③ **会被怎么钻空子**：如果利益足够大，谁会"反向适应"这套建议（钻空子/应付/阳奉阴违）？具体怎么钻；
④ **最坏的代价**：按这套建议执行，最坏情况伤害谁？有什么被忽略的副作用；
⑤ **落地前置条件**：如果坚持要做，必须先具备什么条件 / 先解决什么障碍（给 1-2 条可检查的）。

【输出格式】500-800 字
### 🧐 深批者视角
**① 最脆弱的假设**：【点名 + 具体场景】
**② 现实里会卡在哪**：【点名具体建议 + 卡点】
**③ 会被怎么钻空子**：【具体钻法】
**④ 最坏的代价**：【谁会受损 + 副作用】
**⑤ 如果一定要做，先解决**：【1-2 条前置条件】
**总评**：理念 X/10，落地 X/10 ——【一句话最狠的判断】

团队产出：
{source[:5000]}"""
    try:
        # V15.4：深批者（对抗性批判）分流到 GLM——该模型在批判/挑刺类任务上表现突出
        r = call_llm(prompt, provider="glm", max_tokens=2000, temperature=0.6, timeout=120)
        return r or ""
    except Exception as e:
        print(f"[深批者] 失败: {e}", flush=True)
        return ""

def _aggregate_audit(raw: list, max_items: int = 4) -> list:
    """把引擎产生的审计意见行聚合为 3-5 条要点（对非字符串输入做兜底，避免 AttributeError）"""
    if not raw:
        return []
    # 去掉 markdown 装饰行（先统一转成字符串：raw 里可能混入 None / dict）
    cleaned = [str(l).strip() for l in raw
               if l is not None and str(l).strip()
               and not str(l).strip().startswith("#") and str(l).strip() != "---"]
    # 按 "意见" / 序号 / 关键行 提取
    items = []
    for line in cleaned:
        if any(k in line for k in ("意见", "观察到", "建议", "挑战", "验证", "下一步", "风险")):
            # 聚合连续行
            if items and len(items[-1]) < 60 and line.startswith(("**", "-")):
                items[-1] += " " + line.strip("*- ")
            else:
                items.append(line.strip("*- "))
    # 去重 + 截断
    seen = set()
    result = []
    for item in items:
        key = item[:20]
        if key not in seen and len(item) > 10:
            seen.add(key)
            result.append(item[:150])
        if len(result) >= max_items:
            break
    return result if result else cleaned[:max_items]

