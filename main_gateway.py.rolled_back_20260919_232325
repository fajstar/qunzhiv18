def _valid_key_label(k: str) -> bool:
    """判断 key 是否为有效形态（非占位符）——与 sandbox/app.py 的 _valid_key 同口径"""
    try:
        k.encode("ascii")
    except Exception:
        return False
    low = (k or "").lower()
    return len(k or "") >= 12 and not any(b in low for b in ("your", "replace", "placeholder", "xxx"))

